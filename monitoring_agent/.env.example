# Copy this file to .env and edit only the local copy.
# Never commit, bundle, print, or send the real .env file.
MONITORING_AGENT_ENV_VERSION=2
MONITORING_AGENT_MODE=test
MONITORING_AGENT_INSTANCE_ID=supervision-center-test-01
MONITORING_AGENT_BASE_URL=https://example.invalid:9443
MONITORING_AGENT_EXTERNAL_WEB_URL=https://monitoring.armexholding.cz/
# Use a new empty directory when migrating from a pre-0.6 state contract.
MONITORING_AGENT_STATE_DIR=../monitoring-agent-state-0.6-test
MONITORING_AGENT_TIMEOUT_SECONDS=3.0
MONITORING_AGENT_MAX_ATTEMPTS=3
MONITORING_AGENT_RETRY_BACKOFF_SECONDS=0.5
MONITORING_AGENT_POLL_INTERVAL_SECONDS=60.0
MONITORING_AGENT_POLL_JITTER_SECONDS=5.0
MONITORING_AGENT_ENDPOINT_KEYS=live,ready,system_scheduler,scheduler_detail,system_runtime,system_database,system_proxy,system_smartfuelpass,external_web
MONITORING_AGENT_BEARER_TOKEN=change-me-with-the-existing-monitoring-bearer
